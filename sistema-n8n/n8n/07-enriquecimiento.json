          ],
          "value": {
            "ID_Lead": "={{ $json.ID_Lead }}",
            "Correo": "={{ $json.Correo }}",
            "Telefono": "={{ $json.Telefono }}",
            "Web": "={{ $json.Web }}",
            "Correo_Estado": "={{ $json.Correo_Estado }}",
            "Enriquecer": "={{ $json.Enriquecer }}",
            "Estado": "={{ $json.Estado }}",
            "Notas": "={{ $json.Notas }}"
          }
        },
        "options": {}
      },
      "id": "upd",
      "name": "Actualizar CRM",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1940,
